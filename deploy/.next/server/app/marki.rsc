2:T20c9,{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://автоподборминск.бел/#website","url":"https://автоподборминск.бел","name":"Автоподбор в Минске","description":"Профессиональный автоподбор и диагностика автомобилей перед покупкой в Минске. Договор, отчёт, аргументированный торг.","publisher":{"@id":"https://автоподборминск.бел/#organization"},"inLanguage":"ru","potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://автоподборминск.бел/?s={search_term_string}"},"query-input":"required name=search_term_string"}},{"@type":"WebPage","@id":"https://автоподборминск.бел/#webpage","url":"https://автоподборминск.бел","name":"Автоподбор в Минске — профессиональная диагностика и выездная проверка авто","description":"Комплексная проверка авто перед покупкой в Минске. Launch X431, толщиномер Etari, VIN-аудит, юридическая чистота. Договор, отчёт за 2 часа. От 130 BYN.","isPartOf":{"@id":"https://автоподборминск.бел/#website"},"about":{"@id":"https://автоподборминск.бел/#organization"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://автоподборминск.бел/images/og-image.jpg"},"inLanguage":"ru","datePublished":"2025-01-01","dateModified":"2026-02-28"},{"@type":"Organization","@id":"https://автоподборминск.бел/#organization","name":"Автоподбор в Минске","url":"https://автоподборминск.бел","logo":{"@type":"ImageObject","url":"https://автоподборминск.бел/icon-512.png","width":512,"height":512},"description":"Профессиональный автоподбор и комплексная диагностика автомобилей в Минске. Сканер Launch X431, толщиномер Etari ET-700, юридическая проверка.","telephone":"+375291234567","email":"info@автоподборминск.бел","address":{"@type":"PostalAddress","streetAddress":"ул. Тимирязева, 23","addressLocality":"Минск","postalCode":"220000","addressCountry":"BY"},"contactPoint":[{"@type":"ContactPoint","telephone":"+375291234567","contactType":"customer service","availableLanguage":["Russian","Belarusian"],"areaServed":{"@type":"Country","name":"BY"}}],"sameAs":["https://t.me/autopodborminsk","https://wa.me/375291234567"]},{"@type":"AutoRepair","@id":"https://автоподборминск.бел/#localbusiness","name":"Автоподбор в Минске","image":"https://автоподборминск.бел/images/og-image.jpg","telephone":"+375291234567","email":"info@автоподборминск.бел","url":"https://автоподборминск.бел","address":{"@type":"PostalAddress","streetAddress":"ул. Тимирязева, 23","addressLocality":"Минск","addressRegion":"Минская область","postalCode":"220000","addressCountry":"BY"},"geo":{"@type":"GeoCoordinates","latitude":53.9213,"longitude":27.5275},"openingHoursSpecification":{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"opens":"09:00","closes":"21:00"},"priceRange":"130-1200 BYN","currenciesAccepted":"BYN","paymentAccepted":"Cash, Card","areaServed":{"@type":"City","name":"Минск"},"sameAs":["https://t.me/autopodborminsk","https://wa.me/375291234567"]},{"@type":"Service","@id":"https://автоподборминск.бел/#service","serviceType":"Автоподбор и диагностика автомобилей","provider":{"@id":"https://автоподборминск.бел/#organization"},"areaServed":{"@type":"City","name":"Минск"},"description":"Профессиональная проверка автомобилей перед покупкой: компьютерная диагностика, осмотр кузова, юридическая проверка, аргументированный торг.","hasOfferCatalog":{"@type":"OfferCatalog","name":"Услуги автоподбора в Минске","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Разовая выездная диагностика"},"price":"130","priceCurrency":"BYN","description":"Выезд, кузов, Launch X431, тест-драйв, фотоотчёт"},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Автоподбор под ключ"},"price":"1200","priceCurrency":"BYN","description":"Поиск до результата, полное сопровождение, торг"},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Эксперт на день"},"price":"500","priceCurrency":"BYN","description":"Неограниченное число осмотров с 10:00 до 18:00"}]}},{"@type":"FAQPage","@id":"https://автоподборминск.бел/#faq","url":"https://автоподборминск.бел","inLanguage":"ru","mainEntityOfPage":{"@id":"https://автоподборминск.бел/#webpage"},"mainEntity":[{"@type":"Question","@id":"https://автоподборминск.бел/#faq-q-1","name":"Работаете ли вы с кредитными и лизинговыми автомобилями?","acceptedAnswer":{"@type":"Answer","text":"Да. Мы проверяем остаток задолженности перед лизинговой компанией или банком и сопровождаем процесс корректного закрытия обременения, чтобы право собственности перешло к вам без рисков."}},{"@type":"Question","@id":"https://автоподборминск.бел/#faq-q-2","name":"Какие гарантии предоставляются на подобранный автомобиль?","acceptedAnswer":{"@type":"Answer","text":"Мы гарантируем достоверность технического состояния на момент осмотра. Если наш эксперт пропустил окрас или критическую ошибку в ЭБУ, мы несем материальную ответственность согласно договору."}},{"@type":"Question","@id":"https://автоподборминск.бел/#faq-q-3","name":"Окупается ли стоимость услуг за счет торга с продавцом?","acceptedAnswer":{"@type":"Answer","text":"В среднем, сумма торга в 2–3 раза превышает стоимость нашей услуги «Подбор под ключ». Фактически, для вас наша работа становится бесплатной или даже прибыльной."}},{"@type":"Question","@id":"https://автоподборминск.бел/#faq-q-4","name":"Сколько времени занимает подбор авто «под ключ»?","acceptedAnswer":{"@type":"Answer","text":"В среднем от 5 до 14 рабочих дней в зависимости от ваших требований и бюджета. Чем шире критерии поиска, тем быстрее мы находим достойный вариант."}},{"@type":"Question","@id":"https://автоподборминск.бел/#faq-q-5","name":"Выезжаете ли вы за пределы Минска?","acceptedAnswer":{"@type":"Answer","text":"Да, мы работаем по всей Беларуси. Выезд за пределы МКАД оплачивается дополнительно по тарифу 0,50 BYN/км. Также доступна услуга удаленной проверки для клиентов из регионов и РФ."}}]},{"@type":"BreadcrumbList","@id":"https://автоподборминск.бел/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Главная","item":"https://автоподборминск.бел/"}]}]}0:{"P":null,"b":"xqWx8QvLaam95bucHyngQ","p":"","c":["","marki",""],"i":false,"f":[[["",{"children":["marki",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/a5b3e75279493eac.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],["$","html",null,{"lang":"ru","className":"__variable_fcbcbf __variable_fe7774","children":[["$","head",null,{"children":[["$","link",null,{"rel":"preconnect","href":"https://mc.yandex.ru","crossOrigin":""}],["$","link",null,{"rel":"dns-prefetch","href":"https://mc.yandex.ru"}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}]]}],"$L3"]}]]}],{"children":["marki","$L4",{"children":["__PAGE__","$L5",{},null,false]},null,false]},null,false],"$L6",false]],"m":"$undefined","G":["$7",[]],"s":false,"S":true}
