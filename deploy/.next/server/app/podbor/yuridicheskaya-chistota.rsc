2:T1ef0,{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://автоподборминск.бел/#website","url":"https://автоподборминск.бел","name":"Автоподбор в Минске","description":"Профессиональный автоподбор и диагностика автомобилей перед покупкой в Минске. Договор, отчёт, аргументированный торг.","publisher":{"@id":"https://автоподборминск.бел/#organization"},"inLanguage":"ru","potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://автоподборминск.бел/?s={search_term_string}"},"query-input":"required name=search_term_string"}},{"@type":"WebPage","@id":"https://автоподборминск.бел/#webpage","url":"https://автоподборминск.бел","name":"Автоподбор в Минске — профессиональная диагностика и выездная проверка авто","description":"Комплексная проверка авто перед покупкой в Минске. Launch X431, толщиномер Etari, VIN-аудит, юридическая чистота. Договор, отчёт за 2 часа. От 130 BYN.","isPartOf":{"@id":"https://автоподборминск.бел/#website"},"about":{"@id":"https://автоподборминск.бел/#organization"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://автоподборминск.бел/images/og-image.jpg"},"inLanguage":"ru","datePublished":"2025-01-01","dateModified":"2026-02-23"},{"@type":"Organization","@id":"https://автоподборминск.бел/#organization","name":"Автоподбор в Минске","url":"https://автоподборминск.бел","logo":{"@type":"ImageObject","url":"https://автоподборминск.бел/icon-512.png","width":512,"height":512},"description":"Профессиональный автоподбор и комплексная диагностика автомобилей в Минске. Сканер Launch X431, толщиномер Etari ET-700, юридическая проверка.","telephone":"+375291234567","email":"info@автоподборминск.бел","address":{"@type":"PostalAddress","streetAddress":"ул. Тимирязева, 23","addressLocality":"Минск","postalCode":"220000","addressCountry":"BY"},"contactPoint":[{"@type":"ContactPoint","telephone":"+375291234567","contactType":"customer service","availableLanguage":["Russian","Belarusian"],"areaServed":{"@type":"Country","name":"BY"}}],"sameAs":["https://t.me/autopodborminsk","https://wa.me/375291234567"]},{"@type":"AutoRepair","@id":"https://автоподборминск.бел/#localbusiness","name":"Автоподбор в Минске","image":"https://автоподборминск.бел/images/og-image.jpg","telephone":"+375291234567","email":"info@автоподборминск.бел","url":"https://автоподборминск.бел","address":{"@type":"PostalAddress","streetAddress":"ул. Тимирязева, 23","addressLocality":"Минск","addressRegion":"Минская область","postalCode":"220000","addressCountry":"BY"},"geo":{"@type":"GeoCoordinates","latitude":53.9213,"longitude":27.5275},"openingHoursSpecification":{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"opens":"09:00","closes":"21:00"},"priceRange":"130-900 BYN","currenciesAccepted":"BYN","paymentAccepted":"Cash, Card","areaServed":{"@type":"City","name":"Минск"},"sameAs":["https://t.me/autopodborminsk","https://wa.me/375291234567"]},{"@type":"Service","@id":"https://автоподборминск.бел/#service","serviceType":"Автоподбор и диагностика автомобилей","provider":{"@id":"https://автоподборминск.бел/#organization"},"areaServed":{"@type":"City","name":"Минск"},"description":"Профессиональная проверка автомобилей перед покупкой: компьютерная диагностика, осмотр кузова, юридическая проверка, аргументированный торг.","hasOfferCatalog":{"@type":"OfferCatalog","name":"Услуги автоподбора в Минске","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Разовая выездная диагностика"},"price":"130","priceCurrency":"BYN","description":"Выезд, кузов, Launch X431, тест-драйв, фотоотчёт"},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Автоподбор под ключ"},"price":"900","priceCurrency":"BYN","description":"Поиск до результата, полное сопровождение, торг"},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Эксперт на день"},"price":"380","priceCurrency":"BYN","description":"Неограниченное число осмотров с 10:00 до 18:00"}]}},{"@type":"FAQPage","@id":"https://автоподборминск.бел/#faq","mainEntity":[{"@type":"Question","name":"Работаете ли вы с кредитными и лизинговыми автомобилями?","acceptedAnswer":{"@type":"Answer","text":"Да. Мы проверяем остаток задолженности перед лизинговой компанией или банком и сопровождаем процесс корректного закрытия обременения, чтобы право собственности перешло к вам без рисков."}},{"@type":"Question","name":"Какие гарантии предоставляются на подобранный автомобиль?","acceptedAnswer":{"@type":"Answer","text":"Мы гарантируем достоверность технического состояния на момент осмотра. Если наш эксперт пропустил окрас или критическую ошибку в ЭБУ, мы несем материальную ответственность согласно договору."}},{"@type":"Question","name":"Окупается ли стоимость услуг за счет торга с продавцом?","acceptedAnswer":{"@type":"Answer","text":"В среднем, сумма торга в 2–3 раза превышает стоимость нашей услуги «Подбор под ключ». Фактически, для вас наша работа становится бесплатной или даже прибыльной."}},{"@type":"Question","name":"Сколько времени занимает подбор авто «под ключ»?","acceptedAnswer":{"@type":"Answer","text":"В среднем от 5 до 14 рабочих дней в зависимости от ваших требований и бюджета. Чем шире критерии поиска, тем быстрее мы находим достойный вариант."}},{"@type":"Question","name":"Выезжаете ли вы за пределы Минска?","acceptedAnswer":{"@type":"Answer","text":"Да, мы работаем по всей Беларуси. Выезд за пределы МКАД оплачивается дополнительно по тарифу 0,50 BYN/км. Также доступна услуга удаленной проверки для клиентов из регионов и РФ."}}]},{"@type":"BreadcrumbList","@id":"https://автоподборминск.бел/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Главная","item":"https://автоподборминск.бел/"}]}]}0:{"P":null,"b":"N_IJbGMYozONc7qyTY65v","p":"","c":["","podbor","yuridicheskaya-chistota",""],"i":false,"f":[[["",{"children":["podbor",{"children":["yuridicheskaya-chistota",{"children":["__PAGE__",{}]}]}]},"