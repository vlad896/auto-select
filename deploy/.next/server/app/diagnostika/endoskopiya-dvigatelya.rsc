19:Ta94,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://автоподборминск.бел/diagnostika/endoskopiya-dvigatelya/#webpage","url":"https://автоподборминск.бел/diagnostika/endoskopiya-dvigatelya/","name":"Видеоэндоскопия двигателя в Минске: задиры, нагар, трещины ГБЦ | АвтоПодбор","description":"Эндоскопия цилиндров Full HD зондом: задиры ЦПГ, нагар на клапанах, трещины ГБЦ, разрушение катализатора. Проверка моторов G4KD, N20, TSI, M48. От 90 BYN.","isPartOf":{"@id":"https://автоподборминск.бел/#website"},"inLanguage":"ru"},{"@type":"Service","name":"Видеоэндоскопия двигателя","description":"Осмотр цилиндров двигателя на задиры с помощью артикуляционного Full HD эндоскопа.","provider":{"@type":"Organization","name":"Автоподбор в Минске"},"areaServed":{"@type":"City","name":"Минск"},"offers":{"@type":"Offer","price":"90.00","priceCurrency":"BYN"},"serviceOutput":"Фото и видео отчёт состояния хона, поршней и клапанов."},{"@type":"FAQPage","@id":"https://автоподборминск.бел/diagnostika/endoskopiya-dvigatelya/#faq","url":"https://автоподборминск.бел/diagnostika/endoskopiya-dvigatelya/","inLanguage":"ru","mainEntityOfPage":{"@id":"https://автоподборминск.бел/diagnostika/endoskopiya-dvigatelya/#webpage"},"mainEntity":[{"@type":"Question","name":"Сколько стоит эндоскопия двигателя в Минске?","acceptedAnswer":{"@type":"Answer","text":"От 90 BYN для рядных 4-цилиндровых моторов. V6 — от 150 BYN, V8 — от 220 BYN."}},{"@type":"Question","name":"Каким моторам эндоскопия обязательна?","acceptedAnswer":{"@type":"Answer","text":"Hyundai/Kia G4KD/G4NA, BMW N20/N47/N63, VAG 1.8/2.0 TSI ранних серий, Porsche M48 — все склонны к задирам ЦПГ."}}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Главная","item":"https://автоподборминск.бел/"},{"@type":"ListItem","position":2,"name":"Диагностика","item":"https://автоподборминск.бел/diagnostika/"},{"@type":"ListItem","position":3,"name":"Эндоскопия двигателя","item":"https://а