18:T844,{"@context":"https://schema.org","@graph":[{"@type":"TechArticle","headline":"Экспертиза лакокрасочного покрытия и геометрии кузова","description":"Проверка автомобиля толщиномером, поиск скрытых швов, анализ безопасности SRS и маркировки остекления.","author":{"@type":"Organization","name":"Автоподбор в Минске"}},{"@type":"Service","name":"Проверка кузова и ЛКП автомобиля","provider":{"@type":"Organization","name":"Автоподбор в Минске"},"areaServed":{"@type":"City","name":"Минск"},"offers":{"@type":"Offer","price":"40.00","priceCurrency":"BYN"}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Какая толщина ЛКП считается заводской?","acceptedAnswer":{"@type":"Answer","text":"Заводской окрас обычно находится в диапазоне 80–140 микрон. Значения 160–250 мкм указывают на вторичный окрас, а свыше 300–500 мкм — на наличие шпатлёвки и физического удара."}},{"@type":"Question","name":"Можно ли скрыть ДТП от толщиномера?","acceptedAnswer":{"@type":"Answer","text":"Да, используя детали «в цвет» с разборок. Поэтому помимо толщиномера мы проверяем маркировку стёкол, болты крепления, шагрень, герметик и оптику."}}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Главная","item":"https://автоподборминск.бел/"},{"@type":"ListItem","position":2,"name":"Диагностика","item":"https://автоподборминск.бел/diagnostika/"},{"@type":"ListItem","position":3,"name":"Проверка кузова и ЛКП","item":"https://автоподборминск.бел/diagnostika/proverka-kuzova-lkp/"}]}]}5:["$","$1","c",{"children":[null,[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$18"}}],["$","$Lc",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Ld",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]]}]
