# MySQL (cPanel → MySQL® Databases). Скопируйте в .env.local для разработки.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=your_cpanel_db_user
DATABASE_PASSWORD=your_password
DATABASE_NAME=your_cpanel_db_name

# Admin panel basic auth (/admin/leads)
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=change_me

# Optional Telegram notifications for new leads
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
